rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur ne peut lire/écrire que son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // L'admin peut consulter (lecture seule) l'ensemble des comptes, pour
      // le tableau de statistiques de la page /admin (nombre de CV créés,
      // codes promo les plus utilisés, etc.). Aucune écriture n'est permise
      // par cette règle : l'admin ne modifie jamais le compte d'un tiers.
      allow read: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Codes promo : lecture publique (pour vérifier un code), écriture réservée à l'admin
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Réglages généraux (prix, etc.) : lecture publique, écriture admin uniquement
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Statut actif/inactif des templates : lecture publique, écriture admin uniquement
    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Journal des déclarations de paiement (lecture nécessaire pour vérifier qu'une
    // référence Wave n'est pas réutilisée deux fois)
    match /paymentClaims/{claimId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow delete: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Journal de chaque téléchargement de CV réellement effectué (payant,
    // promo ou admin), utilisé uniquement pour le compteur "CV téléchargés"
    // du tableau de bord admin.
    match /downloads/{downloadId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }
  }
}
